---
import { Image } from 'astro:assets';
import heroImage from '../../assets/Foto Mario Torres.png'
import { basic } from '../../config/cv.json';

---

<section class="py-5 px-4 sm:py-10 lg:py-16">
    <div class="px-4 mx-auto max-w-7xl sm:px-6 lg:px-8">
        <div class="grid items-center grid-cols-1 gap-12 lg:grid-cols-2">
            <div class="relative flex justify-center">
                <Image class="w-full md:max-w-md lg:max-w-md"
                    src={heroImage}
                    alt="Astro portafoclio mario Torres " />
            </div>
            <div>
                <p class="text-lg text-offset">
                    {basic?.job}
                </p>

                <h1 class="text-2xl font-bold sm:text-4xl lg:text-5xl mt-3">
                    {basic?.name}
                </h1>

                <p class="mt-5 text-base sm:text-xl">
                    {basic?.summary}
                </p>

                <button class="btn  mt-10 sm:flex sm:items-center sm:space-x-8" >
                    <a href=`/cv/${basic?.cv_file_name}` title="Download CV" download
                        class="inline-flex items-center justify-center px-10 py-4 text-base text-default " role="button">
                        Download CV
                    </a>
                </button>
            </div>
        </div>
    </div>
</section>
<script>
    import  confetti from "canvas-confetti"
    document.addEventListener('DOMContentLoaded',()=> {
        const button = document.querySelector(".btn a")
        button.addEventListener('mouseover', ()=>{
            confetti({
                particleCount: 200, // Número de partículas
                spread: 80, // Dispersión del confetti
                origin: { y: 0.8 } // Posición de lanzamiento
            })
        })
    })
    
</script>
<style>
    /* From Uiverse.io by nikk7007 */ 
.btn {
 --color: #0a85e9;
 --color2: rgb(10, 25, 30);
 background-color: transparent;
 border-radius: 6px;
 border: .3px solid var(--color);
 transition: .5s;
 position: relative;
 overflow: hidden;
 cursor: pointer;
 z-index: 1;
 font-weight: 300;
 font-size: 17px;
 font-family: 'Roboto', 'Segoe UI', sans-serif;
 text-transform: uppercase;
 color: var(--color);
}

.btn::after, .btn::before {
 content: '';
 display: block;
 height: 100%;
 width: 100%;
 transform: skew(90deg) translate(-50%, -50%);
 position: absolute;
 inset: 50%;
 left: 25%;
 z-index: -1;
 transition: .5s ease-out;
 background-color: var(--color);
}

.btn::before {
 top: -50%;
 left: -25%;
 transform: skew(90deg) rotate(180deg) translate(-50%, -50%);
}

.btn:hover::before {
 transform: skew(45deg) rotate(180deg) translate(-50%, -50%);
}

.btn:hover::after {
 transform: skew(45deg) translate(-50%, -50%);
}

.btn:hover {
 color: var(--color2);
}

.btn:active {
 filter: brightness(.7);
 transform: scale(.98);
}
</style>
