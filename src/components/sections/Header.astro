---
import { Icon } from "astro-icon/components";
import ThemeToggle from "../ThemeToggle.astro";
import { basic } from "../../config/cv.json";

const menuItems = [
  { name: 'About', href: '/' },
  { name: 'Experiencia', href: '#resumen' },
  { name: 'Skills', href: '#skills' },
  { name: 'Portafolio', href: '#portafolio' }

];
---

<header class="bg-background py-4">
  <div class="container max-w-6xl mx-auto flex justify-between items-center px-4 md:px-8">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" width="24" height="24" stroke-width="2">
      <path d="M16.95 9.01c3.02 .739 5.05 2.123 5.05 3.714c0 2.367 -4.48 4.276 -10 4.276s-10 -1.909 -10 -4.276c0 -1.59 2.04 -2.985 5.07 -3.724"></path>
      <path d="M7 9c0 1.105 2.239 2 5 2s5 -.895 5 -2v-.035c0 -2.742 -2.239 -4.965 -5 -4.965s-5 2.223 -5 4.965v.035"></path>
      <path d="M15 17l2 3"></path>
      <path d="M8.5 17l-1.5 3"></path>
      <path d="M12 14h.01"></path>
      <path d="M7 13h.01"></path>
      <path d="M17 13h.01"></path>
    </svg>
    <div class="text-2xl font-bold">
      <a href="/" class="hover:text-offset">{basic?.name}</a>
    </div>

    <div class="flex gap-5">
      <!-- PC Menu -->
      <nav class="hidden sm:flex space-x-6 items-center">
        {menuItems.map((item) => (
          <a href={item.href} class="hover:text-offset">{item.name}</a>
        ))}
      </nav>

      <!-- Mobile Menu Button -->
      <div class="sm:hidden flex">
        <button id="menu-btn" class="focus:outline-none">
          <Icon name="Menu" class="size-6"/>
        </button>
      </div>

      <ThemeToggle />
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden sm:hidden">
    {menuItems.map((item) => (
      <a href={item.href} class="block px-4 py-2 hover:bg-background-offset">
        {item.name}
      </a>
    ))}
  </div>
</header>

<script>
  const menuBtn = document.getElementById('menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  menuBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });
</script>
