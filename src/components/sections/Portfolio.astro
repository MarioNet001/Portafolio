---
import Project from '../Project.astro';
import { projects } from '../../config/cv.json';


---

<section id="portafolio" class="bg-background">
    <div class="container px-6 py-8 mx-auto">
        <h1 class="text-3xl font-semibold text-center capitalize lg:text-4xl">
            Mi Portafolio
        </h1>

        <p class="mt-4 text-center text-offset">
            Estos son algunos de los proyectos que han marcado mi camino, en los cuales he tenido el privilegio de colaborar, dejando en cada uno no solo mi esfuerzo y pasión, sino también un pedazo de mi corazón y aprendizaje.
        </p>

        <div class="grid grid-cols-1 gap-8 mt-8 xl:mt-12 xl:gap-12 md:grid-cols-2 xl:grid-cols-3">
            {projects.map(project => (
                <Project
                    imageUrl={project.imageUrl}
                    title={project.title}
                    github={project.github}
                    type={project.type}
                    link={project.link}
                />
            ))}
        </div>
    </div>
</section>
